# ── Monitor environment ──────────────────────────────────────────────
# Copy to .env and fill in real values

# IP of Windows machine running MT5 Poller + Connector API
WINDOWS_IP=192.168.1.100

# JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# Monitor PostgreSQL password
MONITOR_DB_PASSWORD=monitor
